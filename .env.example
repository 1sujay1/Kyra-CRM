# Kyra Group CRM - Environment Variables Example
# Copy this file to .env.local and populate the secrets.
# NEVER commit .env.local or any .env file to version control.

# Supabase Public (Client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Admin (Server only - NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Meta Lead Ads Webhook & Graph API (Server only)
META_APP_SECRET=your-meta-app-secret-here
META_VERIFY_TOKEN=your-random-webhook-verification-token
META_PAGE_ACCESS_TOKEN=your-long-lived-page-access-token
META_GRAPH_API_VERSION=v21.0

# Google Ads Webhook (Server only)
GOOGLE_ADS_WEBHOOK_KEY=your-google-ads-webhook-secret-key

# CRM Core Configuration
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000000
APP_URL=http://localhost:3000
